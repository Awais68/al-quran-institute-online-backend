# Copy to .env and fill in. Never commit the filled-in file.

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database ---
MONGODB_URI=

# --- Auth ---
AUTH_SECRET=
salt_Rounds=10
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# --- Cloudinary (audio/video submissions) ---
CLOUD_NAME=
API_KEY=
API_SECRET=
CLOUDINARY_URL=

# --- Email ---
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASS=
EMAIL_USER=
EMAIL_PASS=
EMAIL_ADMIN=
EMAIL_CONTACT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- WebRTC (GET /webrtc/ice) ---
# Without a TURN server a call fails whenever either side is behind symmetric
# NAT — most mobile carriers and many office networks. STUN alone is not enough.
#
# Comma-separated. Offer both UDP and a TLS/TCP url so the relay still works
# where UDP is blocked outright:
#   turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Preferred: coturn started with `use-auth-secret` and this as
# `static-auth-secret`. The server then hands each user an HMAC pair that
# expires, so a credential scraped from the browser is useless minutes later.
TURN_STATIC_AUTH_SECRET=
# Only if the provider issues long-term credentials instead. These do not
# expire, so rotate them by hand.
TURN_USERNAME=
TURN_PASSWORD=
# How long an issued credential stays valid.
TURN_TTL_SECONDS=600
# Override the default Google STUN servers if you run your own.
STUN_URLS=
